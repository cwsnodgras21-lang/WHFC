# Supabase — create a new project at https://supabase.com/dashboard
# API settings: Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-anon-key

# Server-only. NEVER expose to the browser or commit real values.
# Used only for documented admin/bootstrap scripts — not for normal inventory RPCs.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: absolute origin embedded in printed location QR codes.
# Falls back to the request origin when unset. Set in production so codes
# printed from a preview deploy still point at the real app.
NEXT_PUBLIC_SITE_URL=https://whfc-inventory.vercel.app

# Nolturn Operations Hub feedback integration. Server-only; never prefix the token
# with NEXT_PUBLIC_. NOLTURN_FEEDBACK_URL may be omitted when using nolturn.io.
NOLTURN_FEEDBACK_TOKEN=nolturn_ops_replace_with_generated_token
NOLTURN_FEEDBACK_URL=https://nolturn.io/api/ops/feedback

# Stripe billing — this app's own subscription with NolTurn (not clinic billing).
# NolTurn owns the Stripe account; one Stripe Customer per app instance.
# Dashboard → Developers → API keys / Webhooks.
STRIPE_SECRET_KEY=sk_live_or_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_PUBLISHABLE_KEY=pk_live_or_test_replace_me

# Optional: the Stripe Price ID shown to admins on the "Set up billing" button.
# Safe to expose to the browser (Stripe price IDs are not secret).
NEXT_PUBLIC_STRIPE_PRICE_ID=price_replace_me

# Nolturn CRM billing-events integration. Server-only; never prefix the token
# with NEXT_PUBLIC_. NOLTURN_BILLING_URL may be omitted when using nolturn.io.
NOLTURN_BILLING_TOKEN=nolturn_billing_replace_with_generated_token
NOLTURN_BILLING_URL=https://nolturn.nolturn.io/api/billing/events
